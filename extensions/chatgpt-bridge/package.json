{
  "name": "@openclaw/chatgpt-bridge",
  "version": "2026.9.5",
  "private": true,
  "description": "Durable ChatGPT Voice bridge for OpenClaw with recoverable long-running tasks",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.9.5",
      "staticAssets": [
        {
          "source": "scripts/lumina-mcp-server.mjs",
          "output": "scripts/lumina-mcp-server.mjs"
        },
        {
          "source": "scripts/lumina-task-cli.mjs",
          "output": "scripts/lumina-task-cli.mjs"
        }
      ]
    }
  }
}
