{
  "name": "lumina-monorepo",
  "version": "1.0.6",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Lumina — AI brain + OpenClaw execution runtime monorepo",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "brain:dev":      "pnpm --filter @lumina/brain dev",
    "brain:build":    "pnpm --filter @lumina/brain build",
    "brain:start":    "pnpm --filter @lumina/brain start",
    "auth:dev":       "pnpm --filter @lumina/auth dev",
    "auth:build":     "pnpm --filter @lumina/auth build",
    "auth:start":     "pnpm --filter @lumina/auth start",
    "openclaw:build": "pnpm --dir Open_PC build:docker",
    "openclaw:ui:build": "pnpm --dir Open_PC ui:build",
    "runtime:start":  "pnpm --filter @lumina/openclaw-runtime start",
    "ui:build":       "pnpm --dir Open_PC ui:build",
    "ui:dev":         "pnpm --dir Open_PC ui:dev",
    "desktop:prepare": "node --experimental-strip-types scripts/prepare-desktop-bundle.ts",
    "desktop:bundle:archive": "node --experimental-strip-types scripts/archive-runtime-bundle.ts",
    "desktop:bootstrapper:build": "node --experimental-strip-types scripts/run-cargo-bootstrapper.ts build --manifest-path rust/lumina-bootstrapper/Cargo.toml --release",
    "desktop:bootstrapper:test": "node --experimental-strip-types scripts/run-cargo-bootstrapper.ts test --manifest-path rust/lumina-bootstrapper/Cargo.toml",
    "desktop:bootstrapper:script:test": "node --experimental-strip-types --test --test-isolation=none tests/msvc-toolchain.test.ts",
    "desktop:bootstrapper:stage": "node --experimental-strip-types scripts/stage-bootstrapper-artifact.ts",
    "desktop:release:manifest": "node --experimental-strip-types scripts/generate-release-manifest.ts",
    "desktop:release:publish": "node --experimental-strip-types scripts/publish-release-artifacts.ts",
    "desktop:release:stage": "node --experimental-strip-types scripts/stage-desktop-release.ts",
    "desktop:contract:test": "node --experimental-strip-types --test --test-isolation=none tests/lumina-bundle-contract.test.ts",
    "desktop:contract:validate": "node --experimental-strip-types scripts/validate-release-contract.ts",
    "desktop:dev":    "pnpm desktop:tauri:dev",
    "desktop:build":  "pnpm desktop:tauri:build",
    "desktop:tauri:dev": "pnpm --filter @lumina/desktop tauri:dev",
    "desktop:tauri:build": "pnpm --filter @lumina/desktop tauri:build",
    "desktop:tauri:archive": "pnpm --filter @lumina/desktop tauri:archive",
    "desktop:dist:win:ci":   "pnpm desktop:release:stage",
    "desktop:dist:mac:ci":   "pnpm desktop:release:stage",
    "desktop:dist:linux:ci": "pnpm desktop:release:stage",
    "desktop:release": "pnpm desktop:release:stage",
    "release":        "pnpm desktop:release:stage",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck":      "pnpm typecheck:scripts && pnpm -r typecheck",
    "protocol:build": "pnpm --filter @lumina/protocol build"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
