# Lumina + OpenClaw environment template
# This file documents the current desktop-to-Render integration used by Lumina_PC.

# -----------------------------
# I24D backend (Render + Supabase)
# -----------------------------
# Supabase project URL and service role key used by I24D_WhatsApp.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional direct Postgres connection string for backend services that still use DATABASE_URL.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Public base URL of the I24D backend deployed on Render.
APP_BASE_URL=https://i24d-whatsapp-ai.onrender.com

# Shared admin token for the OpenAI-compatible API and the OpenClaw remote brain route.
I24D_ADMIN_TOKEN=change-me

# OpenClaw remote brain settings served by I24D_WhatsApp.
OPENCLAW_REMOTE_BRAIN_ENABLED=true
OPENCLAW_REMOTE_BRAIN_SECRET=change-me
OPENCLAW_WEBHOOK_SECRET=change-me
OPENCLAW_REMOTE_BRAIN_MODEL=gpt-5.2

# Core model provider used by the backend itself.
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-5.2

# -----------------------------
# Lumina desktop build defaults
# -----------------------------
# These values are embedded into the packaged Lumina_PC build and written to
# ~/.lumina/config.json on first launch.

LUMINA_AUTH_URL=https://lumina-auth.onrender.com

# Render endpoint used by the bundled local proxy for the OpenAI-compatible path.
LUMINA_I24D_BASE_URL=https://i24d-whatsapp-ai.onrender.com
LUMINA_I24D_CHAT_URL=https://i24d-whatsapp-ai.onrender.com/v1/chat/completions

# Production desktop builds must not embed backend secrets in the installer.
# Leave runtime secrets empty for public builds. Only set this flag for private
# internal builds that are never distributed to end users.
LUMINA_EMBED_RUNTIME_SECRETS=false
LUMINA_I24D_TOKEN=

# Direct OpenClaw remote brain bridge into I24D_WhatsApp.
# Keep the remote brain bridge disabled in public builds unless you have a
# per-user auth layer in front of it. The default Lumina desktop release should
# use the public OpenAI-compatible endpoint above.
LUMINA_REMOTE_BRAIN_ENABLED=false
LUMINA_REMOTE_BRAIN_URL=https://i24d-whatsapp-ai.onrender.com/api/openclaw/brain/turn
LUMINA_REMOTE_BRAIN_SECRET=
LUMINA_REMOTE_BRAIN_TIMEOUT_MS=45000
LUMINA_REMOTE_BRAIN_MAX_TURNS=8
I24D_KEEPWARM_INTERVAL_MS=240000

# External runtime bootstrapper channel and manifest. This will be consumed by
# the Rust bootstrapper/Tauri shell path, not by the bundled Node runtime.
LUMINA_RUNTIME_RELEASE_MANIFEST_URL=
LUMINA_RUNTIME_RELEASE_CHANNEL=stable

# Default model presented inside OpenClaw.
LUMINA_PROVIDER_ID=lumina
LUMINA_MODEL_ID=I24D
LUMINA_MODEL_NAME=Lumina IA
LUMINA_MODEL_CONTEXT_WINDOW=16000
LUMINA_MODEL_MAX_TOKENS=4096
LUMINA_DEFAULT_TAB=instances

# Local runtime ports.
LUMINA_GATEWAY_PORT=18789
LUMINA_PROXY_PORT=4321
LUMINA_PROXY_API_KEY=lumina-local-proxy

# Optional desktop overrides.
LUMINA_REQUIRE_AUTH=false
LUMINA_GITHUB_OWNER=I24D
LUMINA_GITHUB_REPO=Lumina-I24D
