# ── Lumina Auth (Render) ──────────────────────────────────────────────
# PostgreSQL connection string — get from Supabase → Settings → Database → URI
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# JWT secrets — auto-generated by Render in production, set manually for local dev
JWT_ACCESS_SECRET=change-me-generate-a-strong-random-string
JWT_REFRESH_SECRET=change-me-generate-another-strong-random-string

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-lumina-app.com

# Auth service port (Render sets this automatically in production)
# PORT=3200

# ── Lumina Brain (Render) ─────────────────────────────────────────────
# API key that the OpenClaw Runtime uses to authenticate with the brain
BRAIN_API_KEY=change-me-generate-a-strong-random-string

# LLM provider: anthropic | openai | openai-compat
BRAIN_LLM_PROVIDER=anthropic

# LLM model to use for decision-making
# Anthropic: claude-sonnet-4-6 | claude-opus-4-6 | claude-haiku-4-5-20251001
# OpenAI:    gpt-4o | gpt-4o-mini
BRAIN_LLM_MODEL=claude-sonnet-4-6

# API key for the chosen LLM provider
BRAIN_LLM_API_KEY=sk-ant-...

# Only required when BRAIN_LLM_PROVIDER=openai-compat
# BRAIN_LLM_BASE_URL=https://your-openai-compat-endpoint/v1

# JWT secret — must match JWT_ACCESS_SECRET in lumina-auth exactly
JWT_ACCESS_SECRET=change-me-generate-a-strong-random-string

# Supabase PostgreSQL URL — same database used by lumina-auth
# Required only if users connect their own LLM keys (optional feature)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Port the brain listens on (Render sets this automatically)
PORT=3100

# Session TTL in milliseconds (default: 30 minutes)
SESSION_TTL_MS=1800000

# Max tool-calling iterations per turn (prevents infinite loops)
MAX_TOOL_ITERATIONS=5

# ── Lumina Desktop (Electron app config) ─────────────────────────────
# These are written to ~/.lumina/config.json on first launch (auto-generated)
# You only need these for local development overrides

# URL of the deployed lumina-auth service
LUMINA_AUTH_URL=https://lumina-auth.onrender.com

# URL of the deployed lumina-brain service
LUMINA_BRAIN_URL=https://lumina-brain.onrender.com

# ── OpenClaw Runtime (local Windows) ─────────────────────────────────
# URL of the deployed lumina-brain on Render
BRAIN_URL=https://lumina-brain.onrender.com

# Must match BRAIN_API_KEY above
BRAIN_API_KEY=change-me-generate-a-strong-random-string

# Proxy port (OpenClaw points its model provider here)
PROXY_PORT=4321

# OpenClaw gateway port and token
OPENCLAW_PORT=18789
OPENCLAW_TOKEN=2eba3d470fb1ae7ae9f6f747ed0c406bca2b913d3e398c58

# Max milliseconds to wait for brain response
BRAIN_TIMEOUT_MS=60000

# Host state refresh interval in milliseconds
HOST_STATE_REFRESH_MS=15000

# Desktop packaging defaults (generated into the installer at build time)
LUMINA_I24D_BASE_URL=https://i24d-whatsapp-ai.onrender.com
LUMINA_I24D_CHAT_URL=https://i24d-whatsapp-ai.onrender.com/v1/chat/completions
LUMINA_I24D_TOKEN=change-me
LUMINA_MODEL_ID=I24D
LUMINA_MODEL_NAME=I24D (Lumina)
LUMINA_DEFAULT_TAB=instances
LUMINA_GITHUB_OWNER=I24D
LUMINA_GITHUB_REPO=Lumina-I24D
