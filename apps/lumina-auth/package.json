{
  "name": "@lumina/auth",
  "version": "1.0.0",
  "description": "Lumina Auth Service — user registration, login, JWT issuance",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev":       "tsx watch src/server.ts",
    "build":     "tsc",
    "start":     "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "bcryptjs":      "^2.4.3",
    "cors":          "^2.8.5",
    "express":       "^4.19.2",
    "jsonwebtoken":  "^9.0.2",
    "pg":            "^8.12.0",
    "zod":           "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs":     "^2.4.6",
    "@types/cors":         "^2.8.17",
    "@types/express":      "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node":         "^22.0.0",
    "@types/pg":           "^8.11.6",
    "tsx":                 "^4.19.0",
    "typescript":          "^5.5.4"
  }
}
