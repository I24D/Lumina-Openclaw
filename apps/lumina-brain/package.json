{
  "name": "@lumina/brain",
  "version": "1.0.0",
  "description": "Lumina Brain — AI decision engine for OpenClaw Runtime (deployed on Render)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev":       "tsx watch src/server.ts",
    "build":     "tsc",
    "start":     "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lumina/protocol": "workspace:*",
    "@anthropic-ai/sdk": "^0.30.0",
    "express":           "^4.19.2",
    "jsonwebtoken":      "^9.0.2",
    "pg":                "^8.12.0",
    "zod":               "^3.23.8"
  },
  "devDependencies": {
    "@types/express":      "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node":         "^22.0.0",
    "@types/pg":           "^8.11.6",
    "tsx":                 "^4.19.0",
    "typescript":          "^5.5.4"
  }
}
