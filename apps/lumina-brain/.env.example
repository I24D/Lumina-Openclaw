PORT=3100

# ── LUMINA Core bridge ────────────────────────────────────────────────────────
# URL of the running I24D_WhatsApp service (LUMINA AI core).
LUMINA_CORE_URL=https://your-i24d-service.onrender.com

# Shared secret — must match LUMINA_BRAIN_SECRET in I24D_WhatsApp.
LUMINA_BRAIN_SECRET=your_shared_secret_here

# Optional: how long to wait for LUMINA core to respond (ms). Default: 60000.
LUMINA_CORE_TIMEOUT_MS=60000

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secrets — must match lumina-auth service.
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# API key fallback (for non-JWT clients, e.g. Openclaw Runtime direct).
# Auto-generated in Render via generateValue: true.
BRAIN_API_KEY=your_brain_api_key

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TTL_MS=1800000
MAX_TOOL_ITERATIONS=5
