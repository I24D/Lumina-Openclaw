{
  "productName": "Lumina OpenClaw",
  "version": "1.0.10",
  "identifier": "ai.lumina.desktop",
  "build": {
    "frontendDist": "lumina://localhost"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "icon": [
      "../assets/icon.png",
      "../assets/icon.ico"
    ],
    "resources": {
      "../build/runtime-bundle/bundle.manifest.json": "bundle.manifest.json",
      "../config/render-preset.json": "config/render-preset.json",
      "../build/lumina-defaults.json": "config/lumina-defaults.json",
      "../build/runtime-node/": "node",
      "../build/runtime-tools/": "runtime-tools",
      "../build/runtime-bundle/payload/lumina-code/": "lumina-code",
      "../build/runtime-bundle/payload/ui/": "ui",
      "../build/openclaw-package/": "openclaw",
      "../../../tool-proxy/server.mjs": "proxy/server.mjs",
      "../../../tool-proxy/proxy-config.json": "proxy/proxy-config.json",
      "../dist/bootstrap.js": "desktop-shell/bootstrap.js",
      "../dist/config.js": "desktop-shell/config.js",
      "../dist/runtime-paths.js": "desktop-shell/runtime-paths.js",
      "../dist/tauri-bridge.js": "desktop-shell/tauri-bridge.js",
      "../dist/tauri-init.js": "desktop-shell/tauri-init.js",
      "../assets/splash.html": "desktop-shell/splash.html"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "compression": "zlib"
      }
    }
  }
}
